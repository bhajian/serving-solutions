.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
build/
# Local benchmark output (the runners default to --results results).
results/
# Generated benchmark datasets (including the 256K-context comparison).
datasets/generated/
*.env
!*.env.example

# Site values stay local; rendered manifests go to build/site/.
platform/site.env

# Raw study evidence lives in release archives (tracks/<track>/studies/ARCHIVE.md);
# the CSV and JSON summaries that notebooks read stay tracked.
tracks/*/studies/**/intervals-*.f32
tracks/*/studies/**/*.prom
tracks/*/studies/**/*.jsonl
tracks/*/studies/**/*.log
tracks/*/studies/**/*.png
tracks/*/studies/**/*.executed.ipynb
tracks/*/studies/**/run-log*.txt
