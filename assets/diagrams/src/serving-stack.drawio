<mxfile host="tools/render_diagrams.py"><diagram name="The LLM serving stack"><mxGraphModel dx="1600" dy="1460" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1460" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="The LLM serving stack" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A supercomputer for inference: every layer is a choice, and the choices must fit together. The engine must support the model; the control plane must support the engine." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1520" height="24" as="geometry"/></mxCell><mxCell id="c4" value="APPLICATIONS" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F3F4F5;strokeColor=#C4C7CA;dashed=0;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="1260" height="110" as="geometry"/></mxCell><mxCell id="c5" value="ACCESS LAYER" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F3F4F5;strokeColor=#C4C7CA;dashed=0;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="300" y="226" width="1260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="SERVING CONTROL PLANE" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#F3F4F5;strokeColor=#C4C7CA;dashed=0;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="300" y="352" width="1260" height="290" as="geometry"/></mxCell><mxCell id="c7" value="INFERENCE ENGINES" style="html=1;fontFamily=Inter;whiteSp