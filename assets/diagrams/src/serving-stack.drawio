=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="520" height="24" as="geometry"/></mxCell><mxCell id="c63" value="KV size per token&#xa;and the parallelism that fits" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.1;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="864" width="520" height="24" as="geometry"/></mxCell><mxCell id="c64" value="how KV and activations&#xa;move between GPUs and tiers" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.1;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="520" height="24" as="geometry"/></mxCell><mxCell id="c65" value="memory, bandwidth and&#xa;the size of the NVLink domain" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.1;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1156" width="520" height="24" as="geometry"/></mxCell><mxCell id="c66" value="shared techniques: continuous batching · paged KV cache · chunked prefill · prefix caching · speculative decoding" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="320" y="782" width="520" height="24" as="geometry"/></mxCell><mxCell id="c67" value="Status from the recorded studies and ROADMAP.md." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1090" y="1404" width="520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
