lor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=18.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="628.5" y="1164" width="294.5" height="72" as="geometry"/></mxCell><mxCell id="c50" value="GB200 · GB300 NVL72&#xa;rack-scale NVLink" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=18.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="937.0" y="1164" width="294.5" height="72" as="geometry"/></mxCell><mxCell id="c51" value="Vera Rubin&#xa;next generation" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=18.2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1245.5" y="1164" width="294.5" height="72" as="geometry"/></mxCell><mxCell id="c52" value="Scale-up fabric  ·  NVLink / NVSwitch, inside a server or an NVL72 rack" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;" vertex="1" parent="1"><mxGeometry x="320" y="1252" width="1220" height="44" as="geometry"/></mxCell><mxCell id="c53" value="Scale-out fabric  ·  InfiniBand · Spectrum-X Ethernet (RoCE) · ConnectX SuperNICs" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#3C4043;strokeColor=#3C4043;fontColor=#FFFFFF;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="1310" width="1220" height="44" as="geometry"/></mxCell><mxCell id="c54" value="Validated on H200" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=15.4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="1394" width="190" height="40" as="geometry"/></mxCell><mxCell id="c55" value="Manifests or reference, not yet run" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;