int x="1040" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="In this repository: Dynamo graphs and lab manifests are measured on H200 (recorded studies);&#xa;llm-d manifests exist for the B300 reference topology (llm-d track, path 05)." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
