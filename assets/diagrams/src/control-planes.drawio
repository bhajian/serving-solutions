<mxfile host="tools/render_diagrams.py"><diagram name="Two control planes: NVIDIA Dynamo and llm-d"><mxGraphModel dx="1400" dy="780" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="780" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Two control planes: NVIDIA Dynamo and llm-d" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Both run SGLang or vLLM workers, split prefill from decode and move KV over NIXL. They differ in where routing and P/D coordination live." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="NVIDIA Dynamo    [RUN ON H200]" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="580" as="geometry"/></mxCell><mxCell id="c5" value="llm-d    [REFERENCE · NOT YET RUN]" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="640" height="580" as="geometry"/></mxCell><mxCell id="c6" value="Dynamo frontend&#xa;OpenAI API · tokenization · KV-aware router" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="560" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Planner&#xa;SLA autoscaling of&#xa;prefill and decode" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="384" width="270" height="96" as="geometry"/></mxCell><mxCell id="c8" value="Operator + Grove&#xa;DynamoGraphDeployment&#xa;gang scheduling" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="384" width="270" height="96" as="geometry"/></mxCell><mxCell id="c9" value="Prefill workers&#xa;SGLang · vLLM · TRT-LLM" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="270" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Decode workers&#xa;SGLang · vLLM · TRT-LLM" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="260" width="270" height="90" as="geometry"/></mxCell><mxCell id="c11" value="Discovery: Kubernetes API (operator default) or etcd" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=15.4;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="560" height="60" as="geometry"/></mxCell><mxCell id="c12" value="P/D coordination: the frontend picks both workers" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=15.4;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="560" height="60" as="geometry"/></mxCell><mxCell id="c13" value="Gateway (Gateway API)&#xa;Envoy-based gateway + Inference Extension" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="560" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Endpoint picker (EPP)&#xa;pluggable scorers: prefix cache, load, P/D decision&#xa;InferencePool selects the model servers" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="560" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Prefill pods&#xa;vLLM · SGLang" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="390" width="270" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Decode pods&#xa;routing sidecar drives P/D" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="390" width="270" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Discovery: Kubernetes API (InferencePool, labels)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=15.4;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="560" height="60" as="geometry"/></mxCell><mxCell id="c18" value="P/D coordination: a sidecar on the decode pod calls prefill" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=15.4;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="560" height="60" as="geometry"/></mxCell><mxCell id="c1