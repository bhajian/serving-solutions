<mxfile host="tools/render_diagrams.py"><diagram name="Choosing a topology, engine and control plane"><mxGraphModel dx="1400" dy="1010" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1010" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Choosing a topology, engine and control plane" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Answer the questions in order. Any &quot;no&quot; on the left means aggregated replicas with KV-aware routing." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Workload: ISL and OSL distributions, request rate, p99 TTFT and ITL targets" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="660" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Are prefill and decode both a large share of GPU time,&#xa;at the same time, at your peak load?" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="660" height="74" as="geometry"/></mxCell><mxCell id="c6" value="Is p99 inter-token latency a hard SLO?" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="660" height="74" as="geometry"/></mxCell><mxCell id="c7" value="Can you tune the P:D ratio? (4+ nodes, or several&#xa;workers per node, e.g. TP2/TP4 on 8-GPU nodes)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="660" height="74" as="geometry"/></mxCell><mxCell id="c8" value="Is there an RDMA fabric (InfiniBand or RoCE)&#xa;or an NVLink domain for KV transfer?" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="660" height="74" as="geometry"/></mxCell><mxCell id="c9" value="Aggregated: KV transfer over TCP would cost more than it saves" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="660" height="64" as="geometry"/></mxCell><mxCell id="c10" value="Aggregated replicas + KV-aware router&#xa;simplest to run, best TTFT at low load,&#xa;all GPUs prefill and decode.&#xa;Tune chunked prefill to bound decode stalls.&#xa;On 2 × HGX H200 with TP8 workers this is&#xa;usually the right answer (recorded studies)." style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="540" height="194" as="geometry"/></mxCell><mxCell id="c11" value="Disaggregated, Planner-managed P:D&#xa;prefill and decode pools sized for the SLO;&#xa;confirm with a goodput sweep (planned study 01)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="540" height="100" as="geometry"/></mxCell><mxCell id="c12" value="MoE or MLA model (DeepSeek-class, Nemotron Ultra)?" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="540" height="74" as="geometry"/></mxCell><mxCell id="c13" value="Per-phase parallelism&#xa;prefill: TP2–TP4 (+EP) · decode: wide EP + DP attention, MTP" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="814" width="540" height="76" as="geometry"/></mxCell><mxCell id="c14" value="Engine: SGLang · vLLM · TensorRT-LLM, by model support and features" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="660" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Control plane: Dynamo operator (graphs, Planner, KV router) on Kubernetes, or llm-d (Gateway API Inference Extension)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1320" height="60" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="160" as="sourcePoint"/><mxPoint x="370" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="yes" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="274" as="sourcePoint"/><mxPoint x="370" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="yes" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="394" as="sourcePoint"/><mxPoint x="370" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="yes" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="514" as="sourcePoint"/><mxPoint x="370" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="no" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="634" as="sourcePoint"/><mxPoint x="370" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="no" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="237" as="sourcePoint"/><mxPoint x="820" y="237" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="no" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="357" as="sourcePoint"/><mxPoint x="820" y="357" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="no" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="477" as="sourcePoint"/><mxPoint x="820" y="380" as="targetPoint"/><Array as="points"><mxPoint x="760" y="477"/><mxPoint x="760" y="380"/></Array></mxGeometry></mxCell><mxCell id="c24" value="yes" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#76B900;strokeWidth=2;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="597" as="sourcePoint"/><mxPoint x="820" y="597" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="660" as="sourcePoint"/><mxPoint x="1090" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="yes" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="774" as="sourcePoint"/><mxPoint x="1090" y="814" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
