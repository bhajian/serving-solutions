<mxfile host="tools/render_diagrams.py"><diagram name="Dynamo production topology on Kubernetes"><mxGraphModel dx="1400" dy="870" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="870" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Dynamo production topology on Kubernetes" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="What the Dynamo production overlay creates for one model. Arrows show requests (solid), KV transfer (green) and control (dashed)." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Namespace per model · one DynamoGraphDeployment" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="760" height="610" as="geometry"/></mxCell><mxCell id="c5" value="Prefill pool" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="330" height="230" as="geometry"/></mxCell><mxCell id="c6" value="Decode pool" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="730" y="290" width="330" height="230" as="geometry"/></mxCell><mxCell id="c7" value="Cluster services" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="240" height="610" as="geometry"/></mxCell><mxCell id="c8" value="Clients&#xa;OpenAI API" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Gateway API · Envoy&#xa;TLS termination&#xa;OIDC / JWT auth&#xa;per-tenant rate limits" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="260" height="124" as="geometry"/></mxCell><mxCell id="c10" value="Frontend × 2&#xa;KV-aware router, replica sync&#xa;probes require discovered workers" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="330" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Planner (SLA mode)&#xa;reads TTFT / ITL from Prometheus&#xa;sets prefill and decode replicas" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="330" height="100" as="geometry"/></mxCell><mxCell id="c12" value="Prefill worker · TP4&#xa;RDMA device · IPC_LOCK" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="290" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Prefill worker · TP4&#xa;scaled by the Planner" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="290" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Decode worker · TP4" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=15.4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="290" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Decode worker · TP4" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=15.4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="390" width="290" height="50" as="geometry"/></mxCell><mxCell id="c16" value="Decode worker · TP4" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=15.4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="450" width="290" height="50" as="geometry"/></mxCell><mxCell id="c17" value="model-weights PVC (ReadWriteMany)&#xa;staged once by a Job · SHA256SUMS · revision checked by an init container" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="560" width="700" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Default-deny NetworkPolicies: only the gateway reaches the frontend;&#xa;serving pods reach each other" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=14.7;" vertex="1" parent="1"><mxGeometry x="360" y="634" width="700" height="60" as="geometry"/></mxCell><mxCell id="c19" value="Dynamo operator&#xa;reconciles the graph&#xa;into pods and services" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="200" height="90" as="geometry"/></mxCell><mxCell id="c20" value="Grove + KAI&#xa;gang scheduling of&#xa;prefill and decode" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="200" height="90" as="geometry"/></mxCell><mxCell id="c21" value="Kubernetes API&#xa;worker discovery&#xa;(no etcd, no NATS)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="360" width="200" height="90" as="geometry"/></mxCell><mxCell id="c22" value="Observability&#xa;Prometheus · alert rules&#xa;Grafana · canary" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="470" width="200" height="110" as="geometry"/></mxCell><mxCell id="c23" value="NVIDIA GPU Operator&#xa;driver + GPUDirect RDMA · GFD labels · DCGM" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="400" height="80" as="geometry"/></mxCell><mxCell id="c24" value="NVIDIA Network Operator&#xa;RDMA shared device plugin: rdma/rdma_shared_device_a" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#