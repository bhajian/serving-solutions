lor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1106" y="290" width="214" height="140" as="geometry"/></mxCell><mxCell id="c21" value="1 request" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="178" as="sourcePoint"/><mxPoint x="330" y="178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="2 route" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="206" as="sourcePoint"/><mxPoint x="475" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="3 stream tokens" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=1;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="440" as="sourcePoint"/><mxPoint x="100" y="178" as="targetPoint"/><Array as="points"><mxPoint x="140" y="490"/><mxPoint x="70" y="490"/><mxPoint x="70" y="178"/></Array></mxGeometry></mxCell><mxCell id="c24" value="1 request" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="178" as="sourcePoint"/><mxPoint x="1010" y="178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="2 prefill" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="206" as="sourcePoint"/><mxPoint x="930" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="3 KV&#xa;+ state" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#76B900;strokeWidth=2;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="994" y="360" as="sourcePoint"/><mxPoint x="1106" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="4 stream tokens" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=1;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1213" y="430" as="sourcePoint"/><mxPoint x="780" y="178" as="targetPoint"/><Array as="points"><mxPoint x="1213" y="500"/><mxPoint x="750" y="500"/><mxPoint x="750" y="178"/></Array></mxGeometry></mxCell><mxCell id="c28" value="Measured, 8K in / 128K out, 4 × TP4 (recorded studies):" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#1A1A1A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="560" width="520" height="24" as="geometry"/></mxCell><mxCell id="c29" value="prefill chunks stalled running streams for up to 13 s;&#xa;worst inter-token gap 40.4 s; highest output tokens/s." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="100" y="586" width="520" height="24" as="geometry"/></mxCell><mxCell id="c30" value="NIXL over UCX: GPUDirect RDMA on InfiniBand&#xa;(cuda_ipc / NVLink when both workers share a node)" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=14.7;fontColor=#3F6300;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="780" y="445" width="520" height="24" as="geometry"/></mxCell><mxCell id="c31" value="Measured, 8K in / 128K out, 1 × TP4 prefill + 3 × TP4 decode:" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;font