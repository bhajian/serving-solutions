<mxfile host="tools/render_diagrams.py"><diagram name="Aggregated and disaggregated request paths"><mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="700" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Aggregated and disaggregated request paths" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Same 16 GPUs either way. Disaggregation moves each request&#x27;s KV cache (and Mamba state for hybrid models) from a prefill worker to a decode worker." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Aggregated: every worker runs both phases" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="560" as="geometry"/></mxCell><mxCell id="c5" value="Disaggregated: separate prefill and decode pools" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="640" height="560" as="geometry"/></mxCell><mxCell id="c6" value="Client" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="130" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Frontend · KV-aware router" styl