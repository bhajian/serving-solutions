<mxfile host="tools/render_diagrams.py"><diagram name="When disaggregation wins"><mxGraphModel dx="1400" dy="830" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="830" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="When disaggregation wins" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Design guidance with the three measured H200 studies placed on it. Region boundaries are qualitative; experiment 01 measures them." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Low load&#xa;room in every batch: aggregated has&#xa;the best TTFT and the fewest moving parts" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="120" width="360" height="640" as="geometry"/></mxCell><mxCell id="c5" value="High load, prefill-dominated&#xa;aggregated prefills on every GPU;&#xa;a fixed prefill pool caps prefill throughput" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="820" height="200" as="geometry"/></mxCell><mxCell id="c6" value="High load, both phases substantial&#xa;disaggregation can win on goodput at a tight ITL SLO when P:D is tunable&#xa;UNVALIDATED here: planned study 01-pd-ratio-sweep" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="330" width="820" height="220" as="geometry"/></mxCell><mxCell id="c7" value="High load, decode-dominated&#xa;aggregated wins on tokens/s; disaggregated removes prefill stalls&#xa;from the tail ITL. Which matters depends on the SLO." style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#E7E9EB;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="560" width="820" height="200" as="geometry"/></mxCell><mxCell id="c8" value="offered load (requests in flight, requests/s) →" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="780" as="sourcePoint"/><mxPoint x="1350" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#3C4043;strokeWidth=1.5;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="760" as="sourcePoint"/><mxPoint x="140" y="120" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="prefill share&#xa;of GPU time&#xa;(ISL vs OSL)" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="520" height="24" as="geometry"/></mxCell><mxCell id="c11" value="A tighter ITL SLO widens this band: prefill stalls&#xa;in aggregated batches become SLO misses." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=14.7;fontColor=#3F6300;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="600" height="24" as="geometry"/></mxCell><mxCell id="c12" value="" style="ellipse;fillColor=#3C4043;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="185" y="295" width="10" height="10" as="geometry"/></mxCell><mxCell id="c13" value="Nemotron 3 Nano, 128K in / 256 out,&#xa;4 in flight: aggregated 1.62× faster" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=14.7;align=left;" vertex="1" parent="1"><mxGeometry x="202" y="290" width="360" height="20" as="geometry"/></mxCell><mxCell id="c14" value="" style="ellipse;fillColor=#3C4043;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="185" y="385" width="10" height="10" as="geometry"/></mxCell><mxCell id="c15" value="DeepSeek V4 Pro, 256K in, 4 in flight:&#xa;aggregated 5.5× faster;&#xa;PD follow-ups lost prefix reuse" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=14.7;align=left;" vertex="1" parent="1"><mxGeometry x="202" y="380" width="360" height="20" as="geometry"/></mxCell><mxCell id="c16" value="" style="ellipse;fillColor=#76B900;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="795" y="695" width="10" height="10" as="geometry"/></mxCell><mxCell id="c17" value="Nemotron 3 Nano, 8K in / 128K out, 384–512 in flight:&#xa;aggregated 1.34× tokens/s; worst ITL 40.4 s vs 1.1 s" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=14.7;align=left;" vertex="1" parent="1"><mxGeometry x="812" y="690" width="360" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
