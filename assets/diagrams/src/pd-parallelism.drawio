<mxfile host="tools/render_diagrams.py"><diagram name="P:D ratio and per-phase parallelism for MoE and MLA models"><mxGraphModel dx="1400" dy="770" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="770" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="P:D ratio and per-phase parallelism for MoE and MLA models" style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=28.0;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Prefill and decode stress different resources, so each pool gets its own parallelism. Design guidance; see notes for what is measured." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=16.8;fontColor=#5F6368;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Prefill pool: compute-bound" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="520" as="geometry"/></mxCell><mxCell id="c5" value="Decode pool: memory-bandwidth-bound" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C4C7CA;dashed=1;verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=15.4;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="560" height="520" as="geometry"/></mxCell><mxCell id="c6" value="Small TP per worker (TP2–TP4)&#xa;more workers prefill in parallel; long prompts&#xa;split across fewer GPUs per worker" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="500" height="96" as="geometry"/></mxCell><mxCell id="c7" value="Chunked prefill&#xa;4K–16K token chunks; larger chunks lower TTFT&#xa;for 128K+ prompts (planned study 07)" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="266" width="500" height="96" as="geometry"/></mxCell><mxCell id="c8" value="Expert parallelism for MoE (optional)&#xa;experts spread across the prefill GPUs" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F3F4F5;strokeColor=#C4C7CA;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="382" width="500" height="96" as="geometry"/></mxCell><mxCell id="c9" value="Wide expert parallelism (EP)&#xa;each GPU holds a slice of the experts;&#xa;all-to-all dispatch every decode step" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="500" height="96" as="geometry"/></mxCell><mxCell id="c10" value="DP attention for MLA&#xa;each rank keeps whole sequences&#x27; latent KV:&#xa;no KV duplication across TP ranks" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="266" width="500" height="96" as="geometry"/></mxCell><mxCell id="c11" value="MTP / speculative decoding&#xa;DeepSeek V4: EAGLE (topk 1) with the NextN head;&#xa;SGLang 0.5.16 also allows DSPARK" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#EEF6E0;strokeColor=#76B900;fontColor=#3F6300;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="382" width="500" height="96" as="geometry"/></mxCell><mxCell id="c12" value="Bottleneck: TTFT under load&#xa;queueing for prefill when the pool is too small" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=16.8;" vertex="1" parent="1"><mxGeometry x="70" y="498" width="500" height="96" as="geometry"/></mxCell><mxCell id="c13" value="Bottleneck: ITL and batch size&#xa;KV capacity and HBM bandwidth per step" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#C4C7CA;fontColor=#5F6368;dashed=1;fontSize=16.8;" vertex="1" parent="1"><mxGeometry x="830" y="498" width="500" height="96" as="geometry"/></mxCell><mxCell id="c14" value="P : D&#xa;ratio follows&#xa;ISL × rate vs&#xa;OSL × rate&#xa;and the SLO" style="html=1;fontFamily=Inter;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#1A1A1A;dashed=0;fontSize=16.8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="160" height="156" as="geometry"/></mxCell><mxCell id="c15" value="KV transfer (NIXL)" style="html=1;fontFamily=Inter;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#76B900;strokeWidth=2;dashed=0;fontColor=#5F6368;fontSize=14.7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="430" as="sourcePoint"/><mxPoint x="800" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="The Dynamo Planner adjusts prefill and decode replicas within one GPU budget (max_gpu_budget); it has no per-role cap in 1.4.0." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="520" height="24" as="geometry"/></mxCell><mxCell id="c17" value="Measured on the H200 site: TP8 and TP4 layouts only (recorded studies). DP attention + EP and MTP for DeepSeek V4 Pro are experiment 05." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="520" height="24" as="geometry"/></mxCell><mxCell id="c18" value="Do not size a 30B-A3B model like Nemotron 3 Nano at TP8: its weights fit on one GPU; TP2–TP4 workers leave room to tune P:D." style="html=1;fontFamily=Inter;whiteSpace=wrap;text;fontSize=15.4;fontColor=#5F6368;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
