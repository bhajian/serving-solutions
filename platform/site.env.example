# Site values for the Kubernetes manifests and benchmark drivers.
#
#   cp platform/site.env.example platform/site.env   # git-ignored; edit for your cluster
#   python tools/render_site.py --env platform/site.env tracks/nvidia-dynamo/sites/nebius-h200-2x8/nemotron-3-nano --out build/site
#   kubectl --context "$KUBE_CONTEXT" apply -f build/site/06-nemotron-3-nano-h200/40-workers-tp4.yaml
#
# Checked-in manifests carry <PLACEHOLDER> tokens instead of real hostnames and
# addresses. render_site.py substitutes every <NAME> listed here and refuses to
# write a file that still contains an unknown placeholder.

# Kubernetes context used by the documented kubectl commands.
KUBE_CONTEXT=<your-kube-context>

# `kubectl get nodes` names of the two GPU nodes (nodeSelector values).
NODE_A_HOSTNAME=<node-a-name>
NODE_B_HOSTNAME=<node-b-name>

# Node InternalIPs. Workers use hostNetwork, so metrics are scraped on these
# addresses. The benchmark drivers read NODE_A_IP / NODE_B_IP from the environment.
NODE_A_IP=<node-a-internal-ip>
NODE_B_IP=<node-b-internal-ip>

# External address of the frontend LoadBalancer Service, for documentation and
# smoke tests only. Do not commit it.
LOADBALANCER_IP=<loadbalancer-ip>

# CSI volume handles of the two existing model disks (H200 site storage/pv).
# Read them with: kubectl get pv -o custom-columns=NAME:.metadata.name,HANDLE:.spec.csi.volumeHandle
MODEL_DISK_A_HANDLE=<model-disk-a-volume-handle>
MODEL_DISK_B_HANDLE=<model-disk-b-volume-handle>

# B300 reference site (tracks/nvidia-dynamo/sites/hgx-b300-2x8, UNVALIDATED): node private IPs.
B300_NODE_A_IP=<b300-node-a-ip>
B300_NODE_B_IP=<b300-node-b-ip>

# Production overlay (tracks/nvidia-dynamo/production), rendered with tools/render_site.py.
INFERENCE_DOMAIN=<inference-domain>          # routes are <model>.<INFERENCE_DOMAIN>
TLS_CLUSTER_ISSUER=<cert-manager-cluster-issuer>
OIDC_ISSUER_URL=<oidc-issuer-url>
OIDC_AUDIENCE=<oidc-audience>
OIDC_JWKS_URL=<oidc-jwks-url>
RWX_STORAGE_CLASS=<readwritemany-storage-class>
API_SERVER_CIDR=<kubernetes-api-server-cidr>
