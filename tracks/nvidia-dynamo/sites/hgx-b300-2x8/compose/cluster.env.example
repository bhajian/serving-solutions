# -----------------------------------------------------------------------------
# Site settings for the Docker Compose deployments.
#
#   cp tracks/nvidia-dynamo/sites/hgx-b300-2x8/compose/cluster.env.example deploy/cluster.env   # on BOTH nodes, then edit
#
# Every Compose file under deploy/ reads these values with:
#   docker compose --env-file deploy/cluster.env -f deploy/<track>/docker/node-a.yaml ...
#
# Only site-specific values live here. Model-specific engine flags are written
# out in each Compose file so you can read exactly what runs.
# -----------------------------------------------------------------------------

# Private (east-west) IPs of the two GPU servers.
# Node A runs etcd + the Dynamo frontend + one GPU worker.
# Node B runs one GPU worker.
NODE_A_IP=<B300_NODE_A_IP>
NODE_B_IP=<B300_NODE_B_IP>

# Ethernet interface that carries the private IPs above (control traffic, NCCL bootstrap).
IP_IFACE=eth0

# InfiniBand HCAs used for GPU-to-GPU KV-cache transfer (UCX / NIXL).
# List them with: ibv_devinfo -l   or   ibdev2netdev
IB_DEVICES=mlx5_4:1,mlx5_5:1,mlx5_6:1,mlx5_7:1,mlx5_8:1,mlx5_9:1,mlx5_10:1,mlx5_11:1

# Where the model checkpoint was downloaded (identical revision on both nodes).
MODEL_DIR=/data/nemotron-ultra/model

# Writable cache directory for compiled kernels, Triton, torch extensions, etc.
# Each track and role gets its own sub-directory, so caches never collide.
RUNTIME_DIR=/data/nemotron-ultra/runtime
